# ── Apparently App — Environment Variables ──
# Copy this to .env and fill in your values.
# All frontend vars MUST be prefixed with EXPO_PUBLIC_

# ── API ──
# Production backend URL (Hono + tRPC)
EXPO_PUBLIC_RORK_API_BASE_URL=https://api.rork.app

# ── Supabase (public anon key — safe for client, used by Expo app) ──
# Get these from: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
